# =================================================================
# StudyMate Backend Environment Configuration
# =================================================================

# Server Port and Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas Dashboard > Connect > Drivers > Node.js
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/studymate?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/studymate?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_study_mate_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
# Use * for open development or comma-separated URLs: http://localhost:8081,http://192.168.1.50:8081
CORS_ORIGIN=*
