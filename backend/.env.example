# =================================================================
# StudyMate Backend Environment Configuration
# =================================================================

# Server Port and Environment
# In local development: PORT=5000, NODE_ENV=development
# In Render production: PORT is assigned dynamically (usually 10000), set NODE_ENV=production
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas Dashboard > Database > Connect > Drivers > Node.js
# Ensure Network Access in MongoDB Atlas allows 0.0.0.0/0 (or Render's static outbound IP)
# Replace <username> and <password> with your Atlas Database User credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/studymate?retryWrites=true&w=majority

# JWT Authentication Secrets
# Generate a cryptographically secure 64+ char random string for production
# e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_study_mate_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
# Use * for mobile app / Expo Go / cURL API access, or comma-separated origins in production
# Example: https://studymate.app,http://localhost:8081
CORS_ORIGIN=*
