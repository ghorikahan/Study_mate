# StudyMate Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas URI:
# e.g. mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/studymate?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/studymate?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_study_mate_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Optional, defaults to all in development)
CLIENT_URL=*

