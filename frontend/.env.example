# =================================================================
# StudyMate Frontend Environment Configuration
# =================================================================

# API Base URL for backend server:
# - Production Cloud API (Render/Railway): https://studymate-api.onrender.com
# - Physical Android device on local Wi-Fi: http://192.168.1.xxx:5000 (replace with your local PC IP)
# - Android Studio Emulator: http://10.0.2.2:5000
# - Web browser / iOS Simulator: http://localhost:5000
EXPO_PUBLIC_API_URL=http://localhost:5000

# Client Request Timeout in milliseconds (default: 25000 for cloud cold-start resilience)
EXPO_PUBLIC_API_TIMEOUT=25000

