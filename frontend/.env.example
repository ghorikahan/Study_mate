# StudyMate Frontend Environment Configuration

# API Base URL for backend server:
# - For Android physical phone via Expo Go on same Wi-Fi: http://<YOUR_COMPUTER_LOCAL_IP>:5000 (e.g., http://192.168.1.15:5000)
# - For Android Studio Emulator: http://10.0.2.2:5000
# - For Web browser / iOS Simulator: http://localhost:5000
EXPO_PUBLIC_API_URL=http://localhost:5000

